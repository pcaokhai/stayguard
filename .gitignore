# build, generated and vendored output (keep in sync with .claude/settings.json read denies)
node_modules/
vendor/
dist/
coverage/
web/out/
web/.next/
*.tsbuildinfo
api/bin/
*.test
*.out
.env
.env.*
!.env.example
.DS_Store
.shots/
!.env.prod.example
deploy/.rehearse-backups/

# rehearsal evidence: keep the CSV and index, not the heavy files
docs/rehearsal/evidence-*/**/*.webm
docs/rehearsal/evidence-*/**/*.zip
docs/rehearsal/shots-*/
deploy/.rehearse.lock/
__pycache__/

# per-clone rehearsal results are local; Khai names the one file to keep (add a "!docs/rehearsal/<name>.csv" line)
docs/rehearsal/results-*.csv
