# Settings for the backup scripts and the local backup target. Placeholders only: copy what you need into deploy/.env.prod
# (production) or export it (local). Real keys never go in git.

# S3-compatible storage for backups (AWS S3, Cloudflare R2, Backblaze B2, Wasabi, MinIO ...). deploy/backup.sh and
# deploy/restore-rehearsal.sh build an rclone remote from these when BACKUP_REMOTE is empty.
BACKUP_S3_ENDPOINT=https://s3.example.com
BACKUP_S3_BUCKET=stayguard-backups
BACKUP_S3_ACCESS_KEY=replace-with-access-key
BACKUP_S3_SECRET_KEY=replace-with-secret-key
# rclone provider name: AWS, Cloudflare, Other (Backblaze B2, Wasabi, MinIO ...). Default Other.
BACKUP_S3_PROVIDER=Other
BACKUP_S3_REGION=
# A folder inside the bucket, optional.
BACKUP_S3_PREFIX=

# `make backup-test` starts a local S3 server (rclone serve s3, profile "backup" in deploy/compose.yaml) with these local-only values.
# BACKUP_S3_PORT=9000
