# Copy to deploy/.env.prod on the server (chmod 600) and fill in. NEVER commit the real file; this example holds no secrets.
# Generate each secret with the command in its comment.

# The public name of the server. Its DNS A record must already point here.
DOMAIN=stayguard.example.com
# Where Let's Encrypt sends expiry notices.
ACME_EMAIL=ops@example.com

# Database owner password (used only to apply migrations and by backups):  openssl rand -base64 24 | tr -d '/+=' 
POSTGRES_PASSWORD=
# Password of the application role stayguard_app (the API connects as it):   openssl rand -base64 24 | tr -d '/+='
APP_DB_PASSWORD=

# Encrypts guest ID numbers, photos and bank account numbers (standard base64 of exactly 32 bytes):  openssl rand -base64 32
# Losing this key makes that data unreadable: keep a copy somewhere other than this server.
DATA_ENCRYPTION_KEY=

LOG_LEVEL=info

# Off-server backups (deploy/backup.sh): an rclone remote and folder, for example "offsite:stayguard-backups".
BACKUP_REMOTE=
# Days to keep dumps on this server and on the remote.
BACKUP_KEEP_LOCAL_DAYS=7
BACKUP_KEEP_REMOTE_DAYS=60
