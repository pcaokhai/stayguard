{
  "name": "stayguard-web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "test": "vitest run",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "gen:api": "openapi-typescript ../contracts/openapi.yaml -o src/api/generated/schema.d.ts",
    "gen:mocks": "orval --config orval.config.mjs",
    "gen": "npm run gen:api && npm run gen:mocks"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "next": "16.3.8",
    "openapi-fetch": "0.17.0",
    "postcss": "^8.5.28",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "26.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "msw": "3.0.1",
    "openapi-typescript": "7.13.0",
    "orval": "8.39.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
