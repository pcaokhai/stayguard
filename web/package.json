{
  "name": "stayguard-web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:i18n && next build",
    "test": "vitest run",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "gen:api": "openapi-typescript ../contracts/openapi.yaml -o src/api/generated/schema.d.ts",
    "gen:mocks": "orval --config orval.config.mjs && node scripts/fix-blob-mocks.mjs",
    "gen": "npm run gen:api && npm run gen:mocks",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@number-flow/react": "0.6.2",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-table": "9.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.49.0",
    "motion": "13.5.0",
    "next": "16.3.8",
    "openapi-fetch": "0.17.0",
    "postcss": "8.5.28",
    "qrcode": "1.5.4",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "msw": "3.0.1",
    "openapi-typescript": "7.13.0",
    "orval": "8.39.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
